{
    "name": "agentoscope",
    "version": "1.0.0-SNAPSHOT",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun scripts/build.ts",
        "dev": "bun scripts/dev.ts",
        "start": "bun run build && ./dist/agentoscope run",
        "test": "bun test",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/bun": "1.4.4",
        "typescript": "7.0.2"
    },
    "packageManager": "bun@1.4.4"
}
