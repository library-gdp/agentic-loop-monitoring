{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["packages/**", "scripts/**", "*.json", "!**/dist", "!**/node_modules"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "rules": {
            "preset": "recommended"
        }
    }
}
